#!/usr/bin/env bash
# Stub de docker para las suites bats de este kit.
#
# Solo existe dentro de una suite: fuera de ella falla cerrado (97) y no llama
# a Docker. Los datos que entrega son sinteticos y los fija el entorno:
#   STUB_RUNNING=1|0        el servicio aparece activo o no
#   STUB_SERVICES           servicios que el compose declara activos
#   STUB_DUMP_FILE          contenido del dump de base de datos
#   STUB_TAR_DIR            directorio que se empaqueta como tar.gz
#   STUB_FIND_OUTPUT        salida del "find" que valida el destino vacio
#   STUB_PSQL_OUT           respuesta de la consulta que cuenta tablas
#   STUB_SQL_OUT            salida de mysql/mariadb
#   STUB_CP_SRC             origen de "docker cp"
#   STUB_IMAGE_FILE         imagen que "docker image save" escribe
#   STUB_INSPECT_FORMAT     salida de "docker inspect --format=..."
#   STUB_CONTAINER_RUNNING  valor de "{{.State.Running}}"
set -uo pipefail

if [ "${HEFESTO_KIT_TEST:-}" != "1" ]; then
  printf 'tests/stubs/docker: fuera de una suite (falta HEFESTO_KIT_TEST=1); no se llama a Docker.\n' >&2
  exit 97
fi

ESTADO="${BATS_TEST_TMPDIR:-/tmp}/docker-stub-state"
SERVICIOS="${STUB_SERVICES:-app}"

servicios_activos() {
  [ "${STUB_RUNNING:-1}" = "1" ] || return 1
  [ ! -f "$ESTADO" ] || return 1
  return 0
}

pos=""
entrada=""
while [ $# -gt 0 ]; do
  case "$1" in
    --entrypoint) entrada="${2:-}"; shift 2; continue ;;
    --project-directory|--project-name|-f|--file|-p|--env-file|--workdir|--profile|--user|--format|-v|--volume|--network) shift 2; continue ;;
    --rm|--no-deps|-T|-d|--detach|-it|-i|--quiet|-q|-a|-aq|--all) shift; continue ;;
    *) pos="$pos $1"; shift ;;
  esac
done

# La invocacion real es "docker compose ...": se ignoran esos dos prefijos.
set -- $pos
while [ $# -gt 0 ]; do
  case "$1" in
    docker|compose) shift ;;
    *) break ;;
  esac
done
comando="${1:-}"
shift || true
resto="$*"

case "$comando" in
  version)
    printf 'Docker Compose version v2.29.7 (stub)\n'
    exit 0
    ;;
  config)
    exit 0
    ;;
  info)
    printf '%s\n' "${STUB_ARCHITECTURE:-amd64}"
    exit 0
    ;;
  ps)
    case "$resto" in
      *--services*)
        if servicios_activos; then printf '%s\n' "$SERVICIOS"; fi
        ;;
      *-aq*) if servicios_activos; then printf 'stubcontainer0001\n'; fi ;;
      *-q*) if servicios_activos; then printf 'stubcontainer0001\n'; fi ;;
      *) if servicios_activos; then printf 'NAME   STATUS\nstub   running\n'; fi ;;
    esac
    exit 0
    ;;
  stop)
    : > "$ESTADO"
    exit 0
    ;;
  start)
    rm -f "$ESTADO"
    exit 0
    ;;
  kill|rm|pull|up|down|restart|wait|logs|top|port|build)
    exit 0
    ;;
  exec)
    case "$resto" in
      *"occ status"*) printf '{"installed":true,"maintenance":false,"needsDbUpgrade":false,"version":"0.0.0"}\n'; exit 0 ;;
      *"occ maintenance"*) exit 0 ;;
      *) exit 0 ;;
    esac
    ;;
  run)
    case "$entrada" in
      tar)
        dir="${STUB_TAR_DIR:-}"
        if [ -z "$dir" ] || [ ! -d "$dir" ]; then
          printf 'stub docker: falta STUB_TAR_DIR para el tar sintetico\n' >&2
          exit 1
        fi
        tar -czf - -C "$dir" .
        ;;
      find)
        if [ -n "${STUB_FIND_OUTPUT:-}" ]; then
          printf '%s\n' "$STUB_FIND_OUTPUT"
        fi
        ;;
      pg_dump|mysqldump|mariadb-dump)
        if [ -n "${STUB_DUMP_FILE:-}" ] && [ -f "$STUB_DUMP_FILE" ]; then
          cat "$STUB_DUMP_FILE"
        fi
        ;;
      pg_restore)
        case "$resto" in
          *--list*) printf -- '--\n-- PostgreSQL database dump\n--\n' ;;
        esac
        ;;
      psql)
        printf '%s\n' "${STUB_PSQL_OUT:-0}"
        ;;
      mysql|mariadb)
        printf '%s\n' "${STUB_SQL_OUT:-}"
        ;;
      sqlite3)
        printf '%s\n' "${STUB_SQLITE_OUT:-}"
        ;;
      *) : ;;
    esac
    exit 0
    ;;
  cp)
    if [ -n "${STUB_CP_SRC:-}" ] && [ -e "$STUB_CP_SRC" ]; then
      cp -a "$STUB_CP_SRC/." "$2" 2>/dev/null || cp -a "$STUB_CP_SRC" "$2"
    fi
    exit 0
    ;;
  image)
    case "${1:-}" in
      save)
        if [ -n "${STUB_IMAGE_FILE:-}" ]; then
          printf 'imagen sintetica\n' > "$STUB_IMAGE_FILE"
        fi
        exit 0
        ;;
      load) exit 0 ;;
      inspect)
        printf '[{"Id":"sha256:stub","Architecture":"amd64","Os":"linux"}]\n'
        exit 0
        ;;
    esac
    exit 0
    ;;
  container)
    case "${1:-}" in
      inspect)
        if [ "${STUB_CONTAINER_EXISTS:-0}" = "1" ]; then
          printf '[]\n'
          exit 0
        fi
        printf 'Error: No such container: app\n' >&2
        exit 1
        ;;
    esac
    exit 0
    ;;
  inspect)
    if [ -n "${STUB_INSPECT_FORMAT:-}" ]; then
      printf '%s\n' "$STUB_INSPECT_FORMAT"
    else
      printf '[]\n'
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
