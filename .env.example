# =============================================================================
# Hefesto Studio — Kit Rspamd
# Plantilla de variables de entorno. Copie a `.env` y edite.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------
# ESTE ARCHIVO NO CONTIENE NINGUN SECRETO REAL Y NO DEBE CONTENERLOS.
# Los valores de ejemplo son falsos a proposito.
# -----------------------------------------------------------------------------
#
# COMO GENERAR LOS VALORES QUE REQUIEREN AL AZAR
# ------------------------------------------------------------------
# La contrasena de la interfaz web NO se genera con openssl: Rspamd usa su
# propio formato de hash. Genere el hash con el propio Rspamd:
#
#     docker run --rm -it rspamd/rspamd:4.2.2 rspamadm pw
#
# El resultado tiene forma `$2$...`. Se pega en
# `config/local.d/worker-controller.inc`, NO en este archivo.
#
# Para cualquier otro valor aleatorio que se agregue en el futuro:
#
#     openssl rand -hex 32        # 32 bytes en hexadecimal
#     openssl rand -base64 32     # 32 bytes en base64
# =============================================================================


# -----------------------------------------------------------------------------
# Puertos publicados en el host (loopback)
# -----------------------------------------------------------------------------
# Todos se publican SOLO en 127.0.0.1. Rspamd nunca se expone a Internet
# directamente: es un servicio interno al servidor de correo.
# Para cambiar el puerto del host basta cambiar el valor de la izquierda.

# OBLIGATORIA - Puerto en el host para el milter (11332 dentro del contenedor).
# Es el puerto al que apunta `smtpd_milters` en Postfix.
# Debe quedar igual en el host y en la config de Postfix.
RSPAMD_MILTER_PORT=11332

# OBLIGATORIA - Puerto en el host para la interfaz web (11334 dentro).
# Acceda por tunel SSH:  ssh -L 11334:127.0.0.1:11334 usuario@servidor
RSPAMD_CONTROLLER_PORT=11334

# Puerto en el host para la API HTTP de diagnostico (11333 dentro).
# Solo se usa para probar con `curl`. Ver docs/07-PRUEBAS-DE-ACEPTACION.md.
RSPAMD_HTTP_PORT=11333


# -----------------------------------------------------------------------------
# Rspamd
# -----------------------------------------------------------------------------

# OBLIGATORIA - Resolutor DNS que usa Rspamd para consultar listas negras (RBL).
# Valores posibles:
#   - Instalar un resolutor local recursivo (Unbound) y apuntar ahi. Es lo
#     recomendado: muchos RBL (Spamhaus entre otros) rechazan o bloquean las
#     consultas que llegan directo desde IPs de centro de datos.
#   - Usar el resolutor del host: "round-robin:172.17.0.1:53" segun la red.
#   - Dejar vacio para usar el valor por defecto de la imagen.
# Ver docs/03-VARIABLES-Y-COMO-OBTENERLAS.md para detalle.
RSPAMD_DNS_SERVERS=

# OBLIGATORIA - Activar el clasificador bayesiano. Requiere Redis.
# Valores admitidos: 1 (activo) o 0 (desactivado).
RSPAMD_USE_BAYES=1

# Greylisting. Es la capa que mas falsos positivos genera en clientes nuevos.
# Ver README.md, seccion "Rspamd no es perfecto".
# Valores admitidos: 1 (activo) o 0 (desactivado).
RSPAMD_USE_GREYLIST=1


# -----------------------------------------------------------------------------
# ClamAV (solo si usa el perfil "antivirus")
# -----------------------------------------------------------------------------

# Tope de memoria del contenedor clamd. ClamAV necesita entre 1 GB y 2 GB para
# cargar firmas. Si el servidor no tiene esta memoria libre, no active el
# perfil antivirus: el antivirus es opcional, Rspamd funciona sin el.
CLAMAV_MEMSIZE=2g

# Cuantas descargas de firmas se ejecutan al arrancar clamd.
# 1 = una descarga por arranque. Es lo razonable para una Pyme.
CLAMAV_FRESHCLAMD_CHECKS=1


# -----------------------------------------------------------------------------
# Sistema
# -----------------------------------------------------------------------------

# Zona horaria del contenedor. Sin esto las marcas de tiempo del registro y de
# las estadisticas quedan en UTC y se hace dificil correlacionar los incidents.
TZ=America/Santiago


# -----------------------------------------------------------------------------
# Variables administradas por el kit (no se editan a mano)
# -----------------------------------------------------------------------------
# Estas NO van en este archivo. El compose las fija para que coincidan con los
# nombres de servicio de la red de Docker:
#
#   RSPAMD_REDIS_SERVERS=redis
#
# Y la contrasena de la interfaz web vive en:
#
#   config/local.d/worker-controller.inc
#
# ese archivo esta listado en .gitignore porque contiene un hash de contrasena.